{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/.env",
    "app/app/page.js",
    "app/app/layout.js",
    "app/app/anonymousaccount/components/AccountCard.js",
    "app/app/anonymousaccount/components/DeployCard.js",
    "app/app/anonymousaccount/components/AccountsList.js",
    "app/components/Logo.js"
  ],
  "exclude": ["node_modules"]
}
